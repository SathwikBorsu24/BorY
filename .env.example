# BorY — Gemini-only configuration
PORT=3000
MAX_UPLOAD_MB=25

# Gemini API
# Get your key from Google AI Studio and keep it server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_UPLOAD_BASE_URL=https://generativelanguage.googleapis.com/upload/v1beta

# Fast chat context: compact global outline + relevant passages.
CHAT_COVERAGE_CHUNKS=14
CHAT_OUTLINE_MAX_CHARS=9000

# YouTube caption language preference
YOUTUBE_TRANSCRIPT_LANG=en
